# ==============================================================================
# DockerPulse Configuration (.env)
# ==============================================================================
# Generate secure random strings for secrets using:
#   openssl rand -hex 32
# ==============================================================================

# Port to expose on the host machine
PORT=8080

# Secret key used to sign and verify JWT authentication tokens (Required)
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_jwt_secret_token

# Shared secret token used by remote DockerPulse agents to join the fleet (Required)
# Generate with: openssl rand -hex 32
AGENT_SECRET=replace_with_a_secure_random_agent_secret_token

# Optional: Reverse Proxy SSO Authentication headers (Authelia, Authentik, Cloudflare Access)
# PROXY_AUTH_HEADER=Remote-User
# PROXY_EMAIL_HEADER=Remote-Email
